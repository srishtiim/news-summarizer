\f2\fs26 \cf0 CREATE TABLE users (\
  user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\
  email VARCHAR(255) UNIQUE NOT NULL,\
  username VARCHAR(100),\
  password_hash VARCHAR(255) NOT NULL,\
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\
  last_login TIMESTAMP,\
  is_active BOOLEAN DEFAULT true\
);\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Sessions Table (Optional - if using session auth):
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 CREATE TABLE sessions (\
  session_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\
  user_id UUID REFERENCES users(user_id),\
  token VARCHAR(500) UNIQUE NOT NULL,\
  expires_at TIMESTAMP NOT NULL,\
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\
);\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 API Endpoints Needed\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 POST /api/auth/signup\
  Body: \{ email, password, username? \}\
  Returns: \{ success, token, user \}\
\
POST /api/auth/login\
  Body: \{ email, password, remember_me? \}\
  Returns: \{ success, token, user \}\
\
POST /api/auth/logout\
  Headers: \{ Authorization: Bearer <token> \}\
  Returns: \{ success \}\
\
GET /api/auth/me\
  Headers: \{ Authorization: Bearer <token> \}\
  Returns: \{ user \}\
\
POST /api/auth/forgot-password (optional)\
  Body: \{ email \}\
  Returns: \{ success, message \}\
\
POST /api/auth/reset-password (optional)\
  Body: \{ token, new_password \}\
  Returns: \{ success \}\
